# yaml-language-server: $schema=https://raw.githubusercontent.com/BlankSpruce/gersemi/0.29.2/gersemi/configuration.schema.json
---
definitions:
  - tools/cmake
disable_formatting: false
extensions: []
indent: 2
line_length: 120
list_expansion: favour-expansion
sort_order: case-sensitive
unsafe: true
warn_about_unknown_commands: true
