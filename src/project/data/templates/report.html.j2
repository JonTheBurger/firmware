<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.title }}</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0b0e14;
      --panel: #111620;
      --panel-raised: #151c28;
      --panel-hover: #1b2533;
      --border: #263142;
      --text: #e6edf5;
      --muted: #8996a8;
      --subtle: #647187;
      --accent: #8b9cff;
      --error: #ff667a;
      --warning: #f2b75b;
      --note: #69b8f5;
      --success: #62c99a;
      --radius: 10px;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
      font-size: 13px;
    }

    .app { height: 100dvh; display: flex; flex-direction: column; min-height: 0; }
    .topbar {
      height: 62px; flex: 0 0 62px; display: flex; align-items: center;
      justify-content: space-between; padding: 0 22px; border-bottom: 1px solid var(--border);
      background: #0e131c;
    }
    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .brand-mark {
      width: 30px; height: 30px; display: grid; place-items: center; border-radius: 8px;
      color: #c5ceff; background: #252d4a; font-weight: 800; font-size: 15px;
    }
    .brand-title { font-size: 14px; font-weight: 650; letter-spacing: .01em; }
    .brand-subtitle { color: var(--muted); margin-top: 2px; font-size: 11px; }
    .revision { color: var(--muted); font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; }

    .tabs {
      display: flex; align-items: stretch; gap: 4px; padding: 0 22px;
      height: 48px; flex: 0 0 48px; border-bottom: 1px solid var(--border);
      background: #0e131c;
    }
    .tab {
      border: 0; border-bottom: 2px solid transparent; padding: 0 17px;
      color: var(--muted); background: transparent; font: inherit; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .tab.active { color: var(--text); border-bottom-color: var(--accent); }
    .tab:disabled { opacity: .38; cursor: not-allowed; }
    .tab-count {
      border-radius: 20px; padding: 2px 7px; font-size: 10px;
      background: #222c3a; color: #aebbd0;
    }

    .workspace {
      min-height: 0; flex: 1; display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(245px, 1fr);
      gap: 12px; padding: 12px;
    }
    .left-pane {
        min-width: 0;
        min-height: 0;
        display: grid;
        grid-template-rows: minmax(120px, 1fr) 8px minmax(120px, 1fr);
        gap: 0;
    }
    .panel {
      min-width: 0; min-height: 0; background: var(--panel);
      border: 1px solid var(--border); border-radius: var(--radius);
      overflow: hidden; display: flex; flex-direction: column;
    }
    .panel-header {
      min-height: 49px; display: flex; align-items: center; justify-content: space-between;
      gap: 12px; padding: 0 15px; border-bottom: 1px solid var(--border);
    }
    .panel-title { font-size: 12px; font-weight: 650; letter-spacing: .025em; }
    .panel-meta { color: var(--muted); font-size: 11px; }
    .resize-handle {
        height: 8px;
        cursor: row-resize;
        touch-action: none;
        display: flex;
        align-items: center;
        justify-content: center;
        outline: none;
    }
    .resize-handle::after {
        content: "";
        width: 36px;
        height: 3px;
        border-radius: 3px;
        background: var(--border);
        transition: background 0.15s ease, width 0.15s ease;
    }
    .resize-handle:hover::after,
    .resize-handle:focus-visible::after {
        background: var(--accent);
        width: 52px;
    }
    .resize-handle:active::after {
        background: var(--accent);
    }
    .search-wrap { padding: 10px 12px; border-bottom: 1px solid var(--border); }
    .search {
      width: 100%; height: 34px; padding: 0 11px; border-radius: 7px;
      border: 1px solid var(--border); outline: none; background: #0c1119;
      color: var(--text); font: inherit;
    }
    .search:focus { border-color: #687bd2; box-shadow: 0 0 0 2px #687bd226; }
    .search::placeholder { color: var(--subtle); }
    .table-scroll { overflow: auto; min-height: 0; flex: 1; }
    table { border-collapse: collapse; width: 100%; table-layout: fixed; }
    thead { position: sticky; top: 0; z-index: 1; background: #151d29; }
    th {
      color: var(--muted); text-align: left; font-size: 10px; font-weight: 650;
      text-transform: uppercase; letter-spacing: .075em; padding: 10px 12px;
      border-bottom: 1px solid var(--border);
    }
    td {
      padding: 10px 12px; border-bottom: 1px solid #202a38; color: #cbd5e1;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    tbody tr { cursor: pointer; transition: background .12s ease; }
    tbody tr:hover { background: var(--panel-hover); }
    tbody tr.selected { background: #202a42; box-shadow: inset 2px 0 var(--accent); }
    .col-status { width: 105px; }
    .col-tool { width: 100px; }
    .col-file { width: 31%; }
    .status {
      display: inline-flex; align-items: center; border-radius: 5px;
      padding: 3px 7px; text-transform: uppercase; letter-spacing: .045em;
      font-size: 9px; font-weight: 750; border: 1px solid currentColor;
    }
    .status.error { color: var(--error); background: #ff667a12; }
    .status.warning { color: var(--warning); background: #f2b75b12; }
    .status.note { color: var(--note); background: #69b8f512; }
    .file-cell { color: #aab7ca; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; }
    .message-cell { color: #d6deea; }
    .empty-state { padding: 28px; color: var(--muted); text-align: center; }

    .detail-content { min-height: 0; flex: 1; overflow: auto; padding: 15px; }
    .detail-placeholder {
      height: 100%; display: grid; place-items: center; color: var(--subtle);
      text-align: center; line-height: 1.7;
    }
    .detail-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
    .detail-path { color: var(--muted); font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; }
    .code-block {
      margin: 0; padding: 14px 16px; overflow: auto; border: 1px solid #293448;
      border-radius: 8px; background: #0b1018; color: #d8dee9;
      font: 12px/1.7 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      tab-size: 4;
    }
    .code-block .hll { background: #39445a; display: block; }
    {{ pygments_css|safe }}

    .right-pane { min-width: 0; min-height: 0; display: flex; flex-direction: column; gap: 12px; }
    .summary-panel { padding: 15px; }
    .summary-heading { font-size: 12px; font-weight: 650; margin-bottom: 15px; }
    .chart-area { display: flex; align-items: center; justify-content: center; gap: 18px; padding: 4px 0 14px; }
    .donut {
      width: 112px; height: 112px; flex: 0 0 112px; border-radius: 50%;
      background: conic-gradient(
        var(--error) 0 var(--error-end),
        var(--warning) var(--error-end) var(--warning-end),
        var(--note) var(--warning-end) 100%
      );
      position: relative; display: grid; place-items: center;
    }
    .donut::before { content: ""; position: absolute; inset: 9px; border-radius: 50%; background: var(--panel); }
    .donut-center { position: relative; z-index: 1; text-align: center; }
    .donut-total { font-size: 23px; font-weight: 720; letter-spacing: -.05em; }
    .donut-label { color: var(--muted); font-size: 9px; text-transform: uppercase; letter-spacing: .08em; }
    .legend { display: grid; gap: 9px; min-width: 75px; }
    .legend-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--muted); font-size: 11px; }
    .legend-name { display: flex; align-items: center; gap: 7px; }
    .dot { width: 7px; height: 7px; border-radius: 50%; }
    .dot.error { background: var(--error); } .dot.warning { background: var(--warning); } .dot.note { background: var(--note); }
    .legend-value { color: var(--text); font-variant-numeric: tabular-nums; }

    .info-panel { min-height: 0; flex: 1; }
    .info-list { padding: 4px 15px 12px; overflow: auto; }
    .info-item { display: flex; gap: 11px; padding: 13px 0; border-bottom: 1px solid #202a38; }
    .info-item:last-child { border-bottom: 0; }
    .info-icon {
      width: 29px; height: 29px; flex: 0 0 29px; border-radius: 8px;
      display: grid; place-items: center; color: #b8c4ff; background: #252d48;
      font-size: 14px;
    }
    .info-heading { font-size: 11px; font-weight: 650; margin: 1px 0 4px; }
    .info-message { color: var(--muted); font-size: 11px; line-height: 1.5; overflow-wrap: anywhere; }
    .muted-empty { color: var(--subtle); font-size: 11px; padding: 12px 0; }
    .inline-code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.92em;
      padding: 0.1em 0.35em;
      border-radius: 4px;
      background: #1a2232;
      color: #e6edf5;
    }

    .detail-content {
      min-height: 0;
      flex: 1;
      overflow: auto;
      padding: 15px;
      display: flex;
      flex-direction: column;
    }
    .diagnostic-detail {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .empty-source-state {
      flex: 1;
      min-height: 110px;
      display: grid;
      place-items: center;
      pointer-events: none;
      user-select: none;
    }
    .empty-source-icon {
      width: 56px;
      height: 56px;
      color: #36445c;
      opacity: 0.7;
      filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.55));
    }

    .source-code > table {
      width: 100%;
      border-collapse: collapse;
      table-layout: auto;
    }
    .source-code > table > tbody > tr > td {
      padding: 0;
      border-bottom: 0;
      vertical-align: top;
      white-space: normal;
      overflow: visible;
    }
    .source-code .linenos {
      width: 1%;
      padding-right: 1rem;
      text-align: right;
      color: var(--muted);
      user-select: none;
    }
    .source-code .code {
      width: 99%;
    }
    .source-code pre {
      margin: 0;
      overflow-x: auto;
      white-space: pre;
    }
    .markdown-body {
      padding: 1rem;
      border-bottom: 1px solid var(--border);
      overflow: auto;
      margin-bottom: 12px;
    }
    .markdown-body pre {
      overflow-x: auto;
    }

    @media (max-width: 900px) {
      body { overflow: auto; }
      .app { height: auto; min-height: 100dvh; }
      .workspace { grid-template-columns: 1fr; }
      .left-pane { min-height: 760px; }
      .right-pane { display: grid; grid-template-columns: 1fr 1fr; }
      .info-panel { min-height: 220px; }
    }
    @media (max-width: 600px) {
      .topbar { padding: 0 13px; }
      .tabs { padding: 0 8px; }
      .tab { padding: 0 10px; }
      .workspace { padding: 8px; gap: 8px; }
      .left-pane { gap: 8px; min-height: 720px; }
      .right-pane { grid-template-columns: 1fr; }
      .col-tool { width: 75px; }
      .col-file { width: 35%; }
      td, th { padding-left: 8px; padding-right: 8px; }
      .revision { display: none; }
    }
  </style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">CI</div>
      <div>
        <div class="brand-title">{{ report.project }} <span style="color:var(--muted);font-weight:400">/ {{ report.title }}</span></div>
        <div class="brand-subtitle">Continuous integration report</div>
      </div>
    </div>
    <div class="revision">{{ report.revision or "local build" }}</div>
  </header>

  <nav class="tabs" aria-label="Report sections">
    <button class="tab active" type="button" aria-current="page">
      Lint <span class="tab-count">{{ total }}</span>
    </button>
    <button class="tab" type="button" disabled title="Not populated yet">Compile</button>
    <button class="tab" type="button" disabled title="Not populated yet">Test</button>
    <button class="tab" type="button" disabled title="Not populated yet">Coverage</button>
  </nav>

  <main class="workspace">
    <section class="left-pane" aria-label="Lint diagnostics">
      <section class="panel">
        <div class="panel-header">
          <div class="panel-title">Diagnostics</div>
          <div class="panel-meta" id="visible-count">{{ total }} results</div>
        </div>
        <div class="search-wrap">
          <input class="search" id="diagnostic-search" type="search"
                 placeholder="Filter by status, tool, file, or message..." autocomplete="off">
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th class="col-status" data-sort="severity">Status</th>
                <th class="col-tool" data-sort="tool">Tool</th>
                <th class="col-file" data-sort="message">File</th>
                <th>Message</th>
              </tr>
            </thead>
            <tbody id="diagnostic-rows">
              {% for d in diagnostics %}
              {% set file_path = d.extent.file if d.extent else "" %}
              {% set line_no = d.line if d.line is defined and d.line else (d.extent.start.line if d.extent and d.extent.start and d.extent.start.line else none) %}
              <tr data-index="{{ loop.index0 }}" data-search="{{ (d.severity ~ ' ' ~ d.tool ~ ' ' ~ file_path ~ ' ' ~ d.message)|lower|e }}"
                  {% if loop.first %}class="selected"{% endif %}>
                <td><span class="status {{ d.severity }}">{{ d.severity }}</span></td>
                <td>{{ d.tool }}</td>
                <td class="file-cell" title="{{ file_path }}">{{ file_path }}{% if line_no %}:{{ line_no }}{% endif %}</td>
                <td class="message-cell" title="{{ d.message }}">{{ d.message|truncate(150) }}</td>
              </tr>
              {% else %}
              <tr><td colspan="4" class="empty-state">No diagnostics were reported.</td></tr>
              {% endfor %}
            </tbody>
          </table>
          <div class="empty-state" id="no-matches" hidden>No diagnostics match this filter.</div>
        </div>
      </section>

      <div
          class="resize-handle"
          id="diagnostics-resizer"
          role="separator"
          aria-label="Resize diagnostics panels"
          aria-orientation="horizontal"
          aria-valuemin="120"
          aria-valuenow="50"
          aria-valuemax="90"
          tabindex="0"
      ></div>

      <section class="panel">
        <div class="panel-header">
          <div class="panel-title">Diagnostic detail</div>
          <div class="panel-meta" id="detail-tool">Select a result</div>
        </div>
        <div class="detail-content" id="detail-content">
          <div class="detail-placeholder">No diagnostics to display.</div>
        </div>
      </section>
    </section>

    <aside class="right-pane" aria-label="Report summary">
      {% set errors = status_counts.error %}
      {% set warnings = status_counts.warning %}
      {% set notes = status_counts.note %}
      {% set denominator = total if total else 1 %}
      {% set error_end = errors / denominator * 100 %}
      {% set warning_end = (errors + warnings) / denominator * 100 %}
      <section class="panel summary-panel">
        <div class="summary-heading">Status overview</div>
        <div class="chart-area">
          <div class="donut" style="--error-end:{{ error_end }}%;--warning-end:{{ warning_end }}%;{% if not total %}background:#273244;{% endif %}">
            <div class="donut-center">
              <div class="donut-total">{{ total }}</div>
              <div class="donut-label">Findings</div>
            </div>
          </div>
          <div class="legend">
            <div class="legend-item"><span class="legend-name"><i class="dot error"></i>Error</span><b class="legend-value">{{ errors }}</b></div>
            <div class="legend-item"><span class="legend-name"><i class="dot warning"></i>Warning</span><b class="legend-value">{{ warnings }}</b></div>
            <div class="legend-item"><span class="legend-name"><i class="dot note"></i>Note</span><b class="legend-value">{{ notes }}</b></div>
          </div>
        </div>
      </section>

      <section class="panel info-panel">
        <div class="panel-header"><div class="panel-title">Run information</div></div>
        <div class="info-list">
          {% for item in report.info %}
          <div class="info-item">
            <div class="info-icon" aria-hidden="true">{{ item.icon }}</div>
            <div>
              <div class="info-heading">{{ item.heading }}</div>
              <div class="info-message">{{ item.message }}</div>
            </div>
          </div>
          {% else %}
          <div class="muted-empty">No additional information.</div>
          {% endfor %}
        </div>
      </section>
    </aside>
  </main>
</div>

<script id="diagnostic-data" type="application/json">{{ diagnostics|tojson }}</script>
<script>
(() => {
  const diagnostics = JSON.parse(document.getElementById("diagnostic-data").textContent);
  const rows = [...document.querySelectorAll("#diagnostic-rows tr[data-index]")];
  const search = document.getElementById("diagnostic-search");
  const detail = document.getElementById("detail-content");
  const detailTool = document.getElementById("detail-tool");
  const visibleCount = document.getElementById("visible-count");
  const noMatches = document.getElementById("no-matches");

  function selectDiagnostic(index) {
    const d = diagnostics[index];
    if (!d) return;

    rows.forEach((row) =>
      row.classList.toggle("selected", Number(row.dataset.index) === index)
    );

    const rawLine = d.line ?? d.extent?.start?.line;
    const file = escapeHtml(d.file || "");
    const line = rawLine != null ? `:${escapeHtml(String(rawLine))}` : "";
    const location = `${file}${line}`;
    const severity = escapeHtml(d.severity || "");

    detailTool.textContent = d.tool || "";

const tbody = document.getElementById("diagnostic-rows");
let sortKey = null;
let sortAsc = true;

const severityRank = { error: 0, warning: 1, note: 2 };

function compareDiagnostics(a, b) {
  let av, bv;
  if (sortKey === "severity") {
    av = severityRank[a.severity] ?? 99;
    bv = severityRank[b.severity] ?? 99;
    return sortAsc ? av - bv : bv - av;
  }
  if (sortKey === "file") {
    av = `${a.extent?.file || ""}:${a.line ?? a.extent?.start?.line ?? 0}`;
    bv = `${b.extent?.file || ""}:${b.line ?? b.extent?.start?.line ?? 0}`;
  } else {
    av = String(a[sortKey] || "");
    bv = String(b[sortKey] || "");
  }
  return sortAsc ? av.localeCompare(bv) : bv.localeCompare(av);
}

document.querySelectorAll("th[data-sort]").forEach((th) => {
  th.style.cursor = "pointer";
  th.addEventListener("click", () => {
    const key = th.dataset.sort;
    sortAsc = sortKey === key ? !sortAsc : true;
    sortKey = key;

    rows.sort((rowA, rowB) =>
      compareDiagnostics(
        diagnostics[Number(rowA.dataset.index)],
        diagnostics[Number(rowB.dataset.index)]
      )
    );
    tbody.append(...rows);
  });
});

    const hasSource = Boolean(d.highlighted_source && d.highlighted_source.trim());
    const sourceSection = hasSource
      ? `<div class="code-block">${d.highlighted_source}</div>`
      : `<div class="empty-source-state" aria-label="No source snippet available">
           <svg class="empty-source-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
             <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.6"/>
             <path d="M8.5 12.2l2.3 2.3 4.7-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
           </svg>
         </div>`;

    detail.innerHTML = `
      <div class="detail-meta">
        <span class="status ${severity}">${severity}</span>
        <span class="detail-path">${location}</span>
        <span class="panel-meta">${escapeHtml(d.language || "text")}</span>
      </div>
      <div class="diagnostic-detail">
        <div class="diagnostic-message markdown-body">${formatInlineCode(d.message)}</div>
        ${sourceSection}
      </div>`;
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, char => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
    })[char]);
  }

  rows.forEach(row => row.addEventListener("click", () => selectDiagnostic(Number(row.dataset.index))));

  search.addEventListener("input", () => {
    const query = search.value.trim().toLowerCase();
    let count = 0;
    rows.forEach(row => {
      const matches = row.dataset.search.includes(query);
      row.hidden = !matches;
      if (matches) count++;
    });
    visibleCount.textContent = `${count} of ${rows.length} results`;
    noMatches.hidden = count !== 0;
    const selected = rows.find(row => row.classList.contains("selected") && !row.hidden);
    if (!selected) {
      const firstVisible = rows.find(row => !row.hidden);
      if (firstVisible) selectDiagnostic(Number(firstVisible.dataset.index));
    }
  });

  if (diagnostics.length) selectDiagnostic(0);

  const leftPane = document.querySelector(".left-pane");
  const resizer = document.getElementById("diagnostics-resizer");

  const MIN_HEIGHT = 120;

  function resizePanels(clientY) {
      const bounds = leftPane.getBoundingClientRect();
      const available = bounds.height - resizer.offsetHeight;

      const topHeight = Math.max(
          MIN_HEIGHT,
          Math.min(available - MIN_HEIGHT, clientY - bounds.top)
      );

      const bottomHeight = available - topHeight;

      leftPane.style.gridTemplateRows =
          `${topHeight}px 8px ${bottomHeight}px`;

      resizer.setAttribute(
          "aria-valuenow",
          Math.round(topHeight / available * 100)
      );
  }

  resizer.addEventListener("pointerdown", event => {
      event.preventDefault();
      resizer.setPointerCapture(event.pointerId);
      resizePanels(event.clientY);
  });

  resizer.addEventListener("pointermove", event => {
      if (resizer.hasPointerCapture(event.pointerId)) {
          resizePanels(event.clientY);
      }
  });

  resizer.addEventListener("keydown", event => {
      if (event.key !== "ArrowUp" && event.key !== "ArrowDown") {
          return;
      }

      event.preventDefault();

      const bounds = leftPane.getBoundingClientRect();
      const currentHeight = leftPane.querySelector(".panel")
          .getBoundingClientRect().height;

      const adjustment = event.key === "ArrowUp" ? -16 : 16;

      resizePanels(
          bounds.top + currentHeight + adjustment
      );
  });

  document.querySelectorAll("#diagnostic-rows tr[data-index]").forEach((row) => {
    const d = diagnostics[Number(row.dataset.index)];
    const cell = row.querySelector(".message-cell");
    if (!d || !cell) return;
    const text = d.message.length > 150 ? d.message.slice(0, 147) + "..." : d.message;
    cell.innerHTML = formatInlineCode(text);
  });
  function formatInlineCode(text) {
    const parts = String(text ?? "").split(/(`[^`]+`)/g);
    return parts
      .map((part) => {
        if (part.startsWith("`") && part.endsWith("`") && part.length >= 2) {
          return `<code class="inline-code">${escapeHtml(part.slice(1, -1))}</code>`;
        }
        return escapeHtml(part);
      })
      .join("");
  }
})();
</script>
</body>
</html>
